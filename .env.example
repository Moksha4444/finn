# Copy this file to .env and fill in the two keys. .env is gitignored.
# Gemini (cheap tier: classification, extraction, headlines; reads PDFs): https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# Groq (strong tier: promise verdicts, bull/bear; cheap-tier fallback): https://console.groq.com/keys
GROQ_API_KEY=

# --- Everything below is optional. Leave it commented out to use the defaults in backend/finn/llm.py. ---
# Models as provider:model.
# FINN_CHEAP=gemini:gemini-3.5-flash-lite
# FINN_STRONG=groq:openai/gpt-oss-120b
# FINN_CHEAP_FALLBACK=groq:openai/gpt-oss-20b
# FINN_STRONG_FALLBACK=gemini:gemini-3.8-flash
# FINN_FALLBACK=gemini:gemini-3.5-flash          # last resort, live research only
# Per-task override: FINN_TASK_<TASK>=provider:model, e.g.
# FINN_TASK_BULL_BEAR=groq:qwen/qwen3.8-27b

# Live research API (backend/finn/api.py)
# FINN_DAILY_JOBS=8        # live research runs per IST day
# FINN_JOB_TIMEOUT=480     # seconds the page waits before saying the result will be saved
# TZ=Asia/Kolkata          # set on Render so build times print in IST

# Web app (web/.env.local, or Vercel project settings): the Render API for live research.
# Unset = no live research; the 22 precomputed pages and the feed still work.
# NEXT_PUBLIC_API_URL=https://finn-api-72tc.onrender.com
